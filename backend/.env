# Serveur
NODE_ENV=development
PORT=3000

# Base de données (on la configurera plus tard)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankflow_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT - Change ces clés plus tard pour quelque chose de sécurisé !
JWT_SECRET=super_secret_key_change_me_32charsminimum
REFRESH_SECRET=another_secret_key_change_me_32chars
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=7d

# Chiffrement
ENCRYPTION_KEY=32charactersforaes256encryption

# URLs
FRONTEND_URL=http://localhost:3001